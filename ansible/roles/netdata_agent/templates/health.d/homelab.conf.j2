# Managed by herickmotta.homelab.netdata_agent.
# Stock zfs.conf already warns on DEGRADED and crits on FAULTED/UNAVAIL.
# These rules cover SMART, inactive required units, free space, and pools
# that are offline, removed, or suspended.

{% if netdata_agent_enable_zfspool | bool %}
template: homelab_zfs_pool_not_online
      on: zfspool.pool_health_state
   class: Errors
    type: System
component: ZFS
    calc: $faulted + $unavail + $offline + $removed + $suspended
   units: state
   every: 10s
    crit: $this > 0
   delay: down 1m multiplier 1.5 max 1h
 summary: ZFS pool ${label:pool} is not online
    info: ZFS pool ${label:pool} is faulted, unavail, offline, removed, or suspended
      to: sysadmin

{% endif %}
{% if netdata_agent_enable_smartctl | bool %}
template: homelab_smart_failed
      on: smartctl.device_smart_status
   class: Errors
    type: System
component: Disk
    calc: $failed
   units: status
   every: 1m
    crit: $this == 1
   delay: down 1m multiplier 1.5 max 1h
 summary: SMART failed on ${label:device_name}
    info: Device ${label:device_name} serial ${label:serial_number} reported SMART failed
      to: sysadmin

template: homelab_smart_reallocated_sectors
      on: smartctl.device_smart_attr_reallocated_sector_ct
   class: Errors
    type: System
component: Disk
    calc: $reallocated_sector_ct
   units: sectors
   every: 1m
    warn: $this > 0
    crit: $this > 10
   delay: down 15m multiplier 1.5 max 1h
 summary: Reallocated sectors on ${label:device_name}
    info: Device ${label:device_name} serial ${label:serial_number} has reallocated sectors
      to: sysadmin

template: homelab_smart_pending_sectors
      on: smartctl.device_smart_attr_current_pending_sector
   class: Errors
    type: System
component: Disk
    calc: $current_pending_sector
   units: sectors
   every: 1m
    warn: $this > 0
    crit: $this > 10
   delay: down 15m multiplier 1.5 max 1h
 summary: Pending sectors on ${label:device_name}
    info: Device ${label:device_name} serial ${label:serial_number} has current pending sectors
      to: sysadmin

{% endif %}
{% if netdata_agent_required_services | default([]) | length > 0 %}
template: homelab_required_service_inactive
      on: systemd.service_unit_state
chart labels: unit_name={{ netdata_agent_required_services | join(' ') }}
   class: Errors
    type: Linux
component: Systemd units
    calc: $inactive + $failed
   units: state
   every: 10s
    crit: $this > 0
   delay: up 30s down 1m multiplier 1.5 max 1h
 summary: Required systemd unit ${label:unit_name} is inactive
    info: Required service ${label:unit_name} is inactive or failed
      to: sysadmin

{% endif %}
{% if netdata_agent_required_mount_units | default([]) | length > 0 %}
template: homelab_required_mount_inactive
      on: systemd.mount_unit_state
chart labels: unit_name={{ netdata_agent_required_mount_units | join(' ') }}
   class: Errors
    type: Linux
component: Systemd units
    calc: $inactive + $failed
   units: state
   every: 10s
    crit: $this > 0
   delay: up 30s down 1m multiplier 1.5 max 1h
 summary: Required mount ${label:unit_name} is inactive
    info: Required filesystem ${label:unit_name} is unmounted or failed
      to: sysadmin

{% endif %}
{% if netdata_agent_disk_mount_points | default([]) | length > 0 %}
template: homelab_data_mount_free_space
      on: disk.space
chart labels: mount_point={{ netdata_agent_disk_mount_points | join(' ') }}
   class: Utilization
    type: System
component: Disk
    calc: $avail * 100 / ($avail + $used)
   units: %
   every: 1m
    warn: $this < {{ netdata_agent_disk_free_warn_percent }}
    crit: $this < {{ netdata_agent_disk_free_crit_percent }}
   delay: up 1m down 15m multiplier 1.5 max 1h
 summary: Filesystem ${label:mount_point} free space
    info: Free space on ${label:mount_point} is below the configured threshold
      to: sysadmin
{% endif %}
