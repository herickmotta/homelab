{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "accepted_degraded disks stay visible. Standing realloc is not the primary red state; SMART failed, missing serials, pending sectors, and a rise in reallocations are.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "failed" },
                "1": { "color": "green", "index": 0, "text": "passed" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "realloc" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 11 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_smart_status * on(device) group_left(serial_number, model_name, accepted_degraded) smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\",attribute_value_type=\"raw\"} * on(device) group_left(serial_number) smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_attribute{attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"} * on(device) group_left(serial_number) smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_temperature{temperature_type=\"current\"} * on(device) group_left(serial_number) smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "SMART disks",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "serial_number", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "device": true,
              "attribute_id": true,
              "attribute_name": true,
              "attribute_value_type": true,
              "attribute_flags_long": true,
              "attribute_flags_short": true,
              "temperature_type": true,
              "target_name": true
            },
            "indexByName": {
              "serial_number": 0,
              "model_name": 1,
              "accepted_degraded": 2,
              "Value A": 3,
              "Value B": 4,
              "Value C": 5,
              "Value D": 6
            },
            "renameByName": {
              "serial_number": "serial",
              "model_name": "model",
              "accepted_degraded": "accepted_degraded",
              "Value A": "smart",
              "Value B": "realloc",
              "Value C": "pending",
              "Value D": "temp_c"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\",attribute_value_type=\"raw\"} * on(device) group_left(serial_number, accepted_degraded) smartctl_device",
          "legendFormat": "{{serial_number}}",
          "refId": "A"
        }
      ],
      "title": "Reallocated sectors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rise in reallocations on accepted_degraded disks. Standing count is expected; a positive delta is not.",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "delta((smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\",attribute_value_type=\"raw\"} * on(device) group_left(serial_number, accepted_degraded) smartctl_device)[1h:])",
          "legendFormat": "{{serial_number}}",
          "refId": "A"
        }
      ],
      "title": "Reallocated sectors delta 1h",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_attribute{attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"} * on(device) group_left(serial_number) smartctl_device",
          "legendFormat": "{{serial_number}}",
          "refId": "A"
        }
      ],
      "title": "Pending sectors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "celsius" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_temperature{temperature_type=\"current\"} * on(device) group_left(serial_number) smartctl_device",
          "legendFormat": "{{serial_number}}",
          "refId": "A"
        }
      ],
      "title": "Temperature",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homelab", "observability", "smart"],
