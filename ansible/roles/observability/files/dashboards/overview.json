{
  "annotations": { "list": [] },
  "description": "Fleet, NAS/ZFS, Linux hosts, and SMART. Sentinel Linux appears when watchdog :9100 is scraped. Alerts stay on Sentinel; this dashboard does not open Alertmanager.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "down" },
                "1": { "color": "green", "index": 0, "text": "up" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pve_up * on(id) group_left(name, node, type) pve_guest_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "VMs",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "template": true
            },
            "indexByName": {
              "name": 0,
              "id": 1,
              "node": 2,
              "type": 3,
              "Value": 4
            },
            "renameByName": {
              "Value": "status",
              "id": "vmid",
              "name": "guest"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "down" },
                "1": { "color": "green", "index": 0, "text": "up" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=~\"node|observe\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Linux hosts (pve, VMs, Sentinel if scraped)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "target_name": true
            },
            "indexByName": {
              "host": 0,
              "job": 1,
              "Value": 2
            },
            "renameByName": { "Value": "status" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pve_cpu_usage_ratio * on(id) group_left(name) pve_guest_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pve_cpu_usage_ratio{id=\"node/pve\"}",
          "legendFormat": "pve",
          "refId": "B"
        }
      ],
      "title": "VM and hypervisor CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(pve_memory_usage_bytes / pve_memory_size_bytes) * on(id) group_left(name) pve_guest_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pve_memory_usage_bytes{id=\"node/pve\"} / pve_memory_size_bytes{id=\"node/pve\"}",
          "legendFormat": "pve",
          "refId": "B"
        }
      ],
      "title": "VM and hypervisor memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "online" },
                "1": { "color": "yellow", "index": 1, "text": "degraded" },
                "2": { "color": "red", "index": 2, "text": "faulted" },
                "3": { "color": "red", "index": 3, "text": "offline" },
                "4": { "color": "red", "index": 4, "text": "unavail" },
                "5": { "color": "red", "index": 5, "text": "removed" },
                "6": { "color": "red", "index": 6, "text": "suspended" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zfs_pool_health",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "NAS pools",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "target_name": true
            },
            "renameByName": { "Value": "health" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zfs_pool_allocated_bytes / zfs_pool_size_bytes",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "title": "Pool used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "zfs_dataset_used_bytes{name=~\"iron/personal|iron/media|volatile/frigate\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "NAS datasets used",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "target_name": true,
              "pool": true,
              "type": true
            },
            "renameByName": { "name": "dataset", "Value": "used" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_size_bytes{host=\"nas\",fstype=\"virtiofs\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "NAS VirtioFS mounts",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "target_name": true,
              "fstype": true
            },
            "renameByName": {
              "mountpoint": "mount",
              "device": "mapping",
              "Value": "size"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "failed" },
                "1": { "color": "green", "index": 0, "text": "passed" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accepted_degraded" },
            "properties": [{ "id": "custom.width", "value": 140 }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "smartctl_device_smart_status * on(device) group_left(serial_number, accepted_degraded) smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "SMART",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "target_name": true,
              "device": true
            },
            "renameByName": {
              "serial_number": "serial",
              "Value": "smart"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 10,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"node|observe\"}[5m])) * 100)",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Host CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 11,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (node_memory_MemAvailable_bytes{job=~\"node|observe\"} / node_memory_MemTotal_bytes{job=~\"node|observe\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Host memory used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "inactive" },
                "1": { "color": "green", "index": 0, "text": "active" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 40 },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_systemd_unit_state{name=~\"smartmontools.service|zfs-zed.service|smbd.service|sentinel-monitoring.service\",state=\"active\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Storage and Sentinel units",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "state": true,
              "target_name": true
            },
            "renameByName": { "name": "unit", "Value": "active" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "fps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 13,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "frigate_camera_fps",
          "legendFormat": "{{camera}}",
          "refId": "A"
        }
      ],
      "title": "Frigate camera FPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "fps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "id": 14,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "frigate_process_fps",
          "legendFormat": "{{camera}}",
          "refId": "A"
        }
      ],
      "title": "Frigate process FPS",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homelab", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
