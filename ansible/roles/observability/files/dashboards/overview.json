        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "template": true
            },
            "indexByName": {
              "name": 0,
              "id": 1,
              "node": 2,
              "type": 3,
              "Value": 4
            },
            "renameByName": {
              "Value": "status",
              "id": "vmid",
              "name": "guest"
            }
          }
        }
      ],
      "type": "table"
    },
