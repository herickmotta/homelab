      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\"journal|docker\"} |~ \"(?i)(error|failed|critical|panic)\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLines": false,
        "prettifyLogMessage": false
