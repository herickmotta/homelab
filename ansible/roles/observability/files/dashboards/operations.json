      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{job=~\"node|observe\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=~\"node|observe\",mountpoint=\"/\"}))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
