# Managed by herickmotta.homelab.observability.
GF_SECURITY_ADMIN_USER={{ observability_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ observability_grafana_admin_password }}
{% if observability_mail_enabled | bool %}
GF_SMTP_ENABLED=true
GF_SMTP_HOST={{ observability_smtp_host }}:{{ observability_smtp_port | string }}
GF_SMTP_USER={{ observability_smtp_username }}
GF_SMTP_PASSWORD={{ observability_smtp_password }}
GF_SMTP_FROM_ADDRESS={{ observability_smtp_from }}
GF_SMTP_STARTTLS_POLICY={{ 'MandatoryStartTLS' if (observability_smtp_require_tls | bool) else 'NoStartTLS' }}
{% endif %}
{% if observability_pve_enabled | bool %}
PVE_USER={{ observability_pve_user }}
PVE_TOKEN_NAME={{ observability_pve_token_name }}
PVE_TOKEN_VALUE={{ observability_pve_token_value }}
PVE_VERIFY_SSL={{ observability_pve_verify_ssl | bool | lower }}
{% endif %}
