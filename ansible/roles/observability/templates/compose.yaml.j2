# Managed by herickmotta.homelab.observability.
services:
  prometheus:
    image: "{{ observability_prometheus_image }}"
    restart: unless-stopped
    network_mode: host
    user: "65534:65534"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ observability_retention_time }}
      - --storage.tsdb.retention.size={{ observability_retention_size }}
      - --web.listen-address={{ observability_prometheus_listen_address }}
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./data/prometheus:/prometheus
    mem_limit: 2g
    cpus: "1.5"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    labels:
      homelab.role: observability

  grafana:
    image: "{{ observability_grafana_image }}"
    restart: unless-stopped
    network_mode: host
    user: "472:472"
    env_file:
      - .env
    environment:
      GF_SERVER_HTTP_ADDR: "{{ observability_grafana_bind_ip }}"
      GF_SERVER_HTTP_PORT: "{{ observability_grafana_http_port | string }}"
      GF_SERVER_DOMAIN: "{{ observability_grafana_domain }}"
      GF_SERVER_ROOT_URL: "{{ observability_grafana_root_url }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_METRICS_ENABLED: "true"
    volumes:
      - ./data/grafana:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
    mem_limit: 512m
    cpus: "0.5"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    labels:
      homelab.role: observability

  node-exporter:
    image: "{{ observability_node_exporter_image }}"
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ observability_node_exporter_listen_address }}
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/docker/.+|run/docker/netns/.+)($|/)
    read_only: true
    security_opt:
      - no-new-privileges:true
    volumes:
      - /:/host:ro,rslave
    mem_limit: 128m
    cpus: "0.25"
    labels:
      homelab.role: observability

{% if observability_pve_enabled | bool %}
  pve-exporter:
    image: "{{ observability_pve_exporter_image }}"
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    command:
      - --web.listen-address={{ observability_pve_exporter_listen_address }}
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    cpus: "0.5"
    labels:
      homelab.role: observability
{% endif %}
