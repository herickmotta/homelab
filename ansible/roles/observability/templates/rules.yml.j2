# Managed by herickmotta.homelab.observability.
groups:
  - name: observability
    rules:
      - alert: ObserveDiskSpaceLow
        expr: >-
          100 * node_filesystem_avail_bytes{job="observe", mountpoint="/"}
          / node_filesystem_size_bytes{job="observe", mountpoint="/"} < 15
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: Observe root disk has less than 15 percent free
          description: Loki and Prometheus retention may fail if the guest disk fills.

      - alert: ObservePrometheusDown
        expr: up{job="prometheus"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: Observe Prometheus is down
          description: The rich-plane Prometheus self-scrape failed.

      - alert: ObserveGrafanaDown
        expr: up{job="grafana"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: Observe Grafana is down
          description: Grafana metrics on the observability guest are unreachable.

      - alert: ObserveLokiDown
        expr: up{job="loki"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: Observe Loki is down
          description: Loki self-metrics on the observability guest are unreachable.

      - alert: ObservePrometheusConfigReloadFailed
        expr: prometheus_config_last_reload_successful{job="prometheus"} == 0
        for: 5m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: Observe Prometheus rejected its latest configuration
          description: The previous configuration remains active; inspect Prometheus logs.

{% if observability_expected_log_hosts | length > 0 %}
{% for log_host in observability_expected_log_hosts %}
{% set ns = namespace(dependency='none') %}
{% for target in observability_alloy_targets %}
{% if (target.host | default(target.name)) == log_host %}
{% set ns.dependency = target.dependency | default('none') %}
{% endif %}
{% endfor %}
      - alert: AlloyLogPipelineStale
        expr: >-
          (
            sum(increase(loki_write_sent_entries_total{job="alloy",host="{{ log_host }}"}[15m]))
            or
            vector(0)
          ) == 0
          and on() (up{job="alloy",host="{{ log_host }}"} == 1)
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: "{{ ns.dependency }}"
          host: "{{ log_host }}"
        annotations:
          summary: Alloy on {{ log_host }} has not sent logs to Loki
          description: >-
            loki.write sent no entries for 15 minutes while Alloy is still
            scrapeable. A broken journal or Docker pipeline is more likely
            than a quiet host; every shipper emits a bounded heartbeat.
{% endfor %}
{% else %}
      - alert: LokiIngestionStale
        expr: >-
          (
            sum(increase(loki_distributor_lines_received_total[15m]))
            or
            sum(increase(loki_distributor_bytes_received_total[15m]))
          ) == 0
        for: 15m
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: Loki has received no log lines
          description: Alloy push or Loki ingestion has been silent for 15 minutes.
{% endif %}

      - alert: AlloyDown
        expr: up{job="alloy"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
        annotations:
          summary: "Alloy on {{ '{{ $labels.host }}' }} is down"
          description: Observe cannot scrape the Grafana Alloy HTTP endpoint.

      - alert: LocalServiceUnreachable
        expr: homelab_local_tcp_up == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "Local TCP service {{ '{{ $labels.name }}' }} is unreachable"
          description: A host-local probe such as loopback Mosquitto failed.

      - alert: CriticalContainerAbsent
        expr: homelab_container_up == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "Container {{ '{{ $labels.name }}' }} is not running"
          description: An allowlisted Compose service is absent or stopped.

      - alert: CriticalSystemdUnitDown
        expr: >-
          node_systemd_unit_state{name!="alloy.service", state="active",
          host="sentinel"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: none
        annotations:
          summary: "systemd unit {{ '{{ $labels.name }}' }} is not active on {{ '{{ $labels.host }}' }}"
          description: A collected Sentinel unit left the active state.

      - alert: CriticalSystemdUnitDown
        expr: >-
          node_systemd_unit_state{name!="alloy.service", state="active",
          host!="sentinel"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "systemd unit {{ '{{ $labels.name }}' }} is not active on {{ '{{ $labels.host }}' }}"
          description: A collected critical unit left the active state.

      - alert: ZfsPoolUnhealthy
        expr: zfs_pool_health != 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "ZFS pool {{ '{{ $labels.pool }}' }} is not online"
          description: Observe reports a ZFS pool health state other than online.

      - alert: ZfsPoolSpaceLow
        expr: >-
          zfs_pool_allocated_bytes / zfs_pool_size_bytes > 0.85
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "ZFS pool {{ '{{ $labels.pool }}' }} is more than 85 percent allocated"
          description: Dataset growth or a failed scrub consumer may fill the pool.

      - alert: SmartDeviceFailed
        expr: smartctl_device_smart_status == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "SMART failed on {{ '{{ $labels.device }}' }}"
          description: The disk reported a failed SMART health status.

      - alert: SmartPendingSectors
        expr: >-
          smartctl_device_attribute{attribute_name="Current_Pending_Sector",
          attribute_value_type="raw"} > 0
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "Pending sectors on {{ '{{ $labels.device }}' }}"
          description: SMART current pending sector count is above zero.

      - alert: SmartReallocatedSectors
        expr: >-
          smartctl_device_attribute{attribute_name="Reallocated_Sector_Ct",
          attribute_value_type="raw"} > 0
          unless on(device) smartctl_device{accepted_degraded="true"}
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "Reallocated sectors on {{ '{{ $labels.device }}' }}"
          description: Standing reallocations on a disk that is not accepted_degraded.

      - alert: SmartReallocatedSectorsRising
        expr: >-
          increase(smartctl_device_attribute{attribute_name="Reallocated_Sector_Ct",
          attribute_value_type="raw"}[1h]) > 0
        for: 5m
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "Reallocated sector count rose on {{ '{{ $labels.device }}' }}"
          description: A delta is alertable even on accepted_degraded disks.

      - alert: LinuxExporterDown
        expr: up{job="node",host="sentinel"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: none
        annotations:
          summary: "Linux exporter on {{ '{{ $labels.host }}' }} is down"
          description: Observe cannot scrape node_exporter on the Sentinel.

      - alert: LinuxExporterDown
        expr: >-
          up{job=~"observe|smartctl|zfs|pve|pve_exporter"} == 0
          or up{job="node",host!="sentinel"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "Exporter {{ '{{ $labels.job }}' }} is down"
          description: Observe lost a Linux, SMART, ZFS, or Proxmox scrape target.

      - alert: GuestRootFilesystemLow
        expr: >-
          100 * node_filesystem_avail_bytes{job="node", host="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{job="node", host="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"} < 15
        for: 10m
        labels:
          severity: warning
          dependency: none
        annotations:
          summary: Sentinel root filesystem has less than 15 percent free
          description: Guest Linux disk pressure on the independent Sentinel.

      - alert: GuestRootFilesystemLow
        expr: >-
          100 * node_filesystem_avail_bytes{job="node", host!="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{job="node", host!="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"} < 15
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "Root filesystem on {{ '{{ $labels.host }}' }} has less than 15 percent free"
          description: Guest root disk pressure. ObserveDiskSpaceLow covers the observe guest.

      - alert: GuestRootInodesLow
        expr: >-
          100 * node_filesystem_files_free{job="node", host="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_files{job="node", host="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"} < 10
        for: 10m
        labels:
          severity: warning
          dependency: none
        annotations:
          summary: Sentinel root inodes are below 10 percent free
          description: Inode exhaustion can fail deploys before byte capacity does.

      - alert: GuestRootInodesLow
        expr: >-
          100 * node_filesystem_files_free{job=~"node|observe", host!="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_files{job=~"node|observe", host!="sentinel",
          mountpoint="/", fstype!~"tmpfs|overlay|squashfs"} < 10
        for: 10m
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "Root inodes on {{ '{{ $labels.host }}' }} are below 10 percent free"
          description: Inode exhaustion can fail deploys before byte capacity does.

      - alert: ObservePrometheusRuleEvaluationFailures
        expr: increase(prometheus_rule_evaluation_failures_total{job="prometheus"}[10m]) > 0
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: Observe Prometheus failed to evaluate an alert rule
          description: Inspect Prometheus logs and the rendered rules file.

      - alert: ObserveAlertNotificationsDropped
        expr: increase(prometheus_notifications_dropped_total{job="prometheus"}[15m]) > 0
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: Observe Prometheus dropped Alertmanager notifications
          description: The rich plane could not deliver alerts to Grafana Alerting.

{% if (observability_http_targets | default([])) | length > 0
   or (observability_tcp_targets | default([])) | length > 0
   or (observability_icmp_targets | default([])) | length > 0 %}
      - alert: HouseholdEndpointUnavailable
        expr: probe_success{job=~"blackbox_http|blackbox_tcp|blackbox_icmp"} == 0
        for: "{{ observability_alert_for }}"
        labels:
          severity: critical
          dependency: pve
        annotations:
          summary: "Endpoint {{ '{{ $labels.target_name }}' }} is unavailable"
          description: "The {{ '{{ $labels.job }}' }} probe to {{ '{{ $labels.instance }}' }} failed."

      - alert: TlsCertificateExpiring
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 21
        for: 1h
        labels:
          severity: warning
          dependency: pve
        annotations:
          summary: "TLS certificate for {{ '{{ $labels.target_name }}' }} expires in under 21 days"
          description: Renew the lab certificate before HTTPS probes fail.
{% endif %}
