# Managed by herickmotta.homelab.observability.
global:
  scrape_interval: "{{ observability_scrape_interval }}"
  evaluation_interval: "{{ observability_evaluation_interval }}"
  external_labels:
    site: "{{ observability_site_label }}"
    monitor: observability

rule_files:
  - /etc/prometheus/rules/*.yml
{% if observability_grafana_alertmanager_host | default('') | length > 0 %}

alerting:
  alertmanagers:
    - scheme: http
      path_prefix: "{{ observability_grafana_alertmanager_path_prefix | default('/api/alertmanager/grafana') }}"
      api_version: v2
      static_configs:
        - targets:
            - "{{ observability_grafana_alertmanager_host }}"
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "{{ observability_prometheus_listen_address }}"

  - job_name: grafana
    static_configs:
      - targets:
          - "{{ observability_grafana_scrape_address }}"

  - job_name: loki
    static_configs:
      - targets:
          - "{{ observability_loki_ready_address }}"

  - job_name: observe
    static_configs:
      - targets:
          - "{{ observability_node_exporter_listen_address }}"
        labels:
          host: observe

{% if observability_node_targets | length > 0 %}
  - job_name: node
    static_configs:
{% for target in observability_node_targets %}
      - targets:
          - "{{ target.address }}"
        labels:
          host: "{{ target.host | default(target.name) }}"
          target_name: "{{ target.name }}"
{% endfor %}
{% endif %}

{% if observability_smartctl_address | length > 0 %}
  - job_name: smartctl
    static_configs:
      - targets:
          - "{{ observability_smartctl_address }}"
        labels:
          host: pve
          target_name: smartctl
    metric_relabel_configs:
      - target_label: accepted_degraded
        replacement: "false"
{% if observability_accepted_degraded_serials | length > 0 %}
      - source_labels: [serial_number]
        regex: "^({{ observability_accepted_degraded_serials | map('regex_escape') | join('|') }})$"
        target_label: accepted_degraded
        replacement: "true"
{% endif %}
{% endif %}

{% if observability_zfs_address | length > 0 %}
  - job_name: zfs
    static_configs:
      - targets:
          - "{{ observability_zfs_address }}"
        labels:
          host: pve
          target_name: zfs
{% endif %}

{% if observability_alloy_targets | default([]) | length > 0 %}
  # loki.write exports host as the Loki endpoint. honor_labels false keeps the
  # scrape shipper host and renames the endpoint label to exported_host.
  - job_name: alloy
    honor_labels: false
    static_configs:
{% for target in observability_alloy_targets %}
      - targets:
          - "{{ target.address }}"
        labels:
          host: "{{ target.host | default(target.name) }}"
          target_name: "{{ target.name }}"
          dependency: "{{ target.dependency | default('none') }}"
{% endfor %}
{% endif %}

{% if observability_pve_enabled | bool %}
  - job_name: pve_exporter
    static_configs:
      - targets:
          - "{{ observability_pve_exporter_listen_address }}"

  - job_name: pve
    metrics_path: /pve
    params:
      module:
        - default
      cluster:
        - "1"
      node:
        - "1"
    static_configs:
      - targets:
          - "{{ observability_pve_target }}"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ observability_pve_exporter_listen_address }}"
{% endif %}

{% if observability_http_targets | default([]) | length > 0 %}
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
{% for target in observability_http_targets %}
      - targets:
          - "{{ target.address }}"
        labels:
          target_name: "{{ target.name }}"
          target_kind: "{{ target.kind | default('endpoint') }}"
          dependency: "{{ target.dependency | default('pve') }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ observability_blackbox_listen_address }}"
{% endif %}

{% if observability_tcp_targets | default([]) | length > 0 %}
  - job_name: blackbox_tcp
    metrics_path: /probe
    params:
      module:
        - tcp_connect
    static_configs:
{% for target in observability_tcp_targets %}
      - targets:
          - "{{ target.address }}"
        labels:
          target_name: "{{ target.name }}"
          target_kind: "{{ target.kind | default('endpoint') }}"
          dependency: "{{ target.dependency | default('pve') }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ observability_blackbox_listen_address }}"
{% endif %}

{% if observability_icmp_targets | default([]) | length > 0 %}
  - job_name: blackbox_icmp
    metrics_path: /probe
    params:
      module:
        - icmp_ipv4
    static_configs:
{% for target in observability_icmp_targets %}
      - targets:
          - "{{ target.address }}"
        labels:
          target_name: "{{ target.name }}"
          target_kind: "{{ target.kind | default('endpoint') }}"
          dependency: "{{ target.dependency | default('pve') }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ observability_blackbox_listen_address }}"
{% endif %}

{% for target in observability_metrics_targets | default([]) %}
  - job_name: "metrics_{{ target.name }}"
    scheme: "{{ target.scheme | default('http') }}"
    metrics_path: "{{ target.metrics_path | default('/metrics') }}"
    static_configs:
      - targets:
          - "{{ target.address }}"
        labels:
          target_name: "{{ target.name }}"
          dependency: "{{ target.dependency | default('none') }}"
{% if target.keep_metrics | default([]) | length > 0 %}
    metric_relabel_configs:
      - source_labels: [__name__]
        action: keep
        regex: "{{ target.keep_metrics | join('|') }}"
{% endif %}
{% endfor %}
