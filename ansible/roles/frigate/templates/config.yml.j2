# Managed by herickmotta.homelab.frigate. Camera credentials come from env.
mqtt:
  enabled: false

auth:
  enabled: {{ frigate_auth_enabled | bool | lower }}

proxy:
  default_role: {{ frigate_proxy_default_role }}

tls:
  enabled: false

{% if frigate_gpu_enabled | bool %}
ffmpeg:
  hwaccel_args: preset-vaapi
{% endif %}

detectors:
  ov:
    type: openvino
    device: {{ frigate_openvino_device }}

{% if frigate_model == 'yolov9s320' %}
model:
  model_type: yolo-generic
  width: 320
  height: 320
  input_tensor: nchw
  input_dtype: float
  path: /config/model_cache/{{ frigate_yolov9_filename }}
  labelmap_path: /labelmap/coco-80.txt
{% else %}
{# Frigate 0.17 OpenVINO requires an explicit model.path; omitting it crash-loops. #}
model:
  width: 300
  height: 300
  input_tensor: nhwc
  input_pixel_format: bgr
  path: /openvino-model/ssdlite_mobilenet_v2.xml
  labelmap_path: /openvino-model/coco_91cl_bkgr.txt
{% endif %}

objects:
  track:
    - person
    - cat

record:
  enabled: true
  retain:
    days: {{ frigate_record_days }}
    mode: all
  alerts:
    retain:
      days: {{ frigate_alert_days }}
  detections:
    retain:
      days: {{ frigate_detection_days }}

snapshots:
  enabled: true
  retain:
    default: {{ frigate_snapshot_days }}

go2rtc:
{% if frigate_gpu_enabled | bool %}
  ffmpeg:
{% if frigate_gpu_hw_decode | bool %}
    vaapi_rtsp: "-init_hw_device vaapi=va:{{ frigate_gpu_render_node }} -filter_hw_device va -hwaccel vaapi -hwaccel_device va -hwaccel_output_format vaapi -fflags nobuffer -flags low_delay -timeout 5000000 -user_agent go2rtc/ffmpeg -rtsp_flags prefer_tcp -i {{ '{input}' }}"
    h264_vaapi_crop_top: "-vf hwdownload,format=nv12,crop=iw:ih/2:0:0,hwupload -c:v h264_vaapi -g 50 -bf 0 -profile:v high -level:v 4.1 -sei:v 0"
    h264_vaapi_crop_bottom: "-vf hwdownload,format=nv12,crop=iw:ih/2:0:ih/2,hwupload -c:v h264_vaapi -g 50 -bf 0 -profile:v high -level:v 4.1 -sei:v 0"
{% else %}
    vaapi_rtsp: "-init_hw_device vaapi=va:{{ frigate_gpu_render_node }} -filter_hw_device va -fflags nobuffer -flags low_delay -timeout 5000000 -user_agent go2rtc/ffmpeg -rtsp_flags prefer_tcp -i {{ '{input}' }}"
    h264_vaapi_crop_top: "-vf format=nv12,crop=iw:ih/2:0:0,hwupload -c:v h264_vaapi -g 50 -bf 0 -profile:v high -level:v 4.1 -sei:v 0"
    h264_vaapi_crop_bottom: "-vf format=nv12,crop=iw:ih/2:0:ih/2,hwupload -c:v h264_vaapi -g 50 -bf 0 -profile:v high -level:v 4.1 -sei:v 0"
{% endif %}
{% endif %}
  streams:
{% for stream_name, sources in frigate_go2rtc_streams.items() %}
    {{ stream_name }}:
{% for source in sources %}
      - "{{ source }}"
{% endfor %}
{% endfor %}

cameras:
{% for camera in frigate_cameras %}
{% set detect_stream = camera.detect_stream | default(camera.name) %}
{% set record_stream = camera.record_stream | default(camera.name) %}
  {{ camera.name }}:
    enabled: {{ camera.enabled | default(false) | bool | lower }}
    ffmpeg:
      inputs:
{% if detect_stream == record_stream %}
        - path: rtsp://127.0.0.1:8554/{{ detect_stream }}
          input_args: preset-rtsp-restream
          roles:
            - detect
            - record
{% else %}
        - path: rtsp://127.0.0.1:8554/{{ detect_stream }}
          input_args: preset-rtsp-restream
          roles:
            - detect
        - path: rtsp://127.0.0.1:8554/{{ record_stream }}
          input_args: preset-rtsp-restream
          roles:
            - record
{% endif %}
    detect:
      enabled: true
      width: {{ camera.detect_width | default(frigate_detect_width) }}
      height: {{ camera.detect_height | default(frigate_detect_height) }}
      fps: {{ camera.detect_fps | default(frigate_detect_fps) }}
    objects:
      track:
        - person
        - cat
{% if camera.zones is defined and camera.zones | length > 0 %}
    zones:
{% for zone in camera.zones %}
      {{ zone.name }}:
        coordinates: "{{ zone.coordinates }}"
{% if zone.objects is defined %}
        objects:
{% for object in zone.objects %}
          - {{ object }}
{% endfor %}
{% endif %}
{% if zone.loitering_time is defined %}
        loitering_time: {{ zone.loitering_time }}
{% endif %}
{% endfor %}
{% endif %}
{% if camera.review is defined %}
    review:
{{ camera.review | to_nice_yaml(indent=2) | indent(6, first=true) }}
{% endif %}
{% endfor %}

# Local classifiers (visitor_type, gate state, cat_identity) stay omitted until
# the Frigate UI has enough labeled examples. Do not invent polygons here.
