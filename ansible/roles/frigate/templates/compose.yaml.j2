# Managed by herickmotta.homelab.frigate.
services:
  frigate:
    image: "{{ frigate_image }}"
    restart: unless-stopped
    shm_size: "{{ frigate_shm_size }}"
    env_file: .env
    ports:
      - "{{ frigate_port }}:8971"
{% if frigate_loopback_api | bool %}
      - "127.0.0.1:5000:5000"
{% endif %}
{% if frigate_gpu_enabled | bool %}
    devices:
      - /dev/dri:/dev/dri
    cap_add:
      - CAP_PERFMON
{% endif %}
    volumes:
      - ./config:/config
      - {{ frigate_media_path }}:/media/frigate
      - /etc/localtime:/etc/localtime:ro
    tmpfs:
      - /tmp/cache:size={{ frigate_cache_size_mb }}m
    healthcheck:
      test:
        - CMD-SHELL
        - wget -qO- http://127.0.0.1:5000/api/version >/dev/null
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
{% if frigate_mqtt_enabled | bool %}
    networks:
      - default
      - mqtt
{% endif %}
    labels:
      homelab.role: frigate
{% if frigate_mqtt_enabled | bool %}

networks:
  mqtt:
    name: "{{ frigate_mqtt_network }}"
    external: true
{% endif %}
