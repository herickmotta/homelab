# Managed by herickmotta.homelab.sentinel_monitoring.
global:
  resolve_timeout: 5m
{% if sentinel_monitoring_mail_enabled | bool %}
  smtp_smarthost: {{ (sentinel_monitoring_smtp_host ~ ':' ~ sentinel_monitoring_smtp_port) | to_json }}
  smtp_from: {{ sentinel_monitoring_smtp_from | to_json }}
  smtp_auth_username: {{ sentinel_monitoring_smtp_username | to_json }}
  smtp_auth_password: {{ sentinel_monitoring_smtp_password | to_json }}
  smtp_require_tls: {{ sentinel_monitoring_smtp_require_tls | bool | lower }}
{% endif %}

route:
  receiver: "{{ sentinel_monitoring_default_receiver }}"
  group_by:
    - alertname
    - site
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
{% if sentinel_monitoring_hermes_webhook_url | length > 0 %}
  routes:
    - receiver: hermes
      continue: true
    - receiver: "{{ sentinel_monitoring_default_receiver }}"
{% endif %}

inhibit_rules:
  - source_matchers:
      - alertname="HypervisorUnavailable"
    target_matchers:
      - dependency="pve"
    equal:
      - site

receivers:
  - name: discard
{% if sentinel_monitoring_mail_enabled | bool %}
  - name: email
    email_configs:
      - to: {{ sentinel_monitoring_email_destination | to_json }}
        send_resolved: true
{% endif %}
{% if sentinel_monitoring_hermes_webhook_url | length > 0 %}
  - name: hermes
    webhook_configs:
      - url: {{ sentinel_monitoring_hermes_webhook_url | to_json }}
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: {{ sentinel_monitoring_hermes_webhook_secret | to_json }}
{% endif %}
