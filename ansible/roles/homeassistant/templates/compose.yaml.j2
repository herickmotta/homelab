# Managed by herickmotta.homelab.homeassistant.
services:
  homeassistant:
    image: "{{ homeassistant_image }}"
    restart: unless-stopped
    network_mode: host
    env_file: .env
    volumes:
      - ./config:/config
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8123/', timeout=5)
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    labels:
      homelab.role: homeassistant
