#!/bin/sh
set -eu

required_driver="{{ proxmox_host_power_required_scaling_driver }}"
governor="{{ proxmox_host_power_cpu_governor }}"
preference="{{ proxmox_host_power_energy_performance_preference }}"
policy_count=0

for governor_file in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  [ -e "${governor_file}" ] || continue
  policy_dir=${governor_file%/*}

  active_driver=$(cat "${policy_dir}/scaling_driver")
  if [ "${active_driver}" != "${required_driver}" ]; then
    echo "unexpected CPU scaling driver: ${active_driver}" >&2
    exit 1
  fi

  available_governors=$(cat "${policy_dir}/scaling_available_governors")
  case " ${available_governors} " in
    *" ${governor} "*)
      ;;
    *)
      echo "unsupported CPU governor: ${governor}" >&2
      exit 1
      ;;
  esac

  preference_file=${policy_dir}/energy_performance_preference
  available_preferences_file=${policy_dir}/energy_performance_available_preferences
  if [ ! -e "${preference_file}" ] || [ ! -e "${available_preferences_file}" ]; then
    echo "energy performance preference is unavailable" >&2
    exit 1
  fi

  available_preferences=$(cat "${available_preferences_file}")
  case " ${available_preferences} " in
    *" ${preference} "*)
      ;;
    *)
      echo "unsupported energy performance preference: ${preference}" >&2
      exit 1
      ;;
  esac

  printf '%s\n' "${governor}" >"${governor_file}"
  printf '%s\n' "${preference}" >"${preference_file}"
  policy_count=$((policy_count + 1))
done

if [ "${policy_count}" -eq 0 ]; then
  echo "no CPU frequency policies were found" >&2
  exit 1
fi
