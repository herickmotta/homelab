# Managed by herickmotta.homelab.data_platform.
services:
  db:
    image: "{{ data_platform_postgres_image_repository }}@{{ data_platform_postgres_image_digest }}"
    restart: unless-stopped
    env_file:
      - "{{ data_platform_config_dir }}/stack.env"
    environment:
      POSTGRES_DB: "{{ data_platform_postgres_db }}"
      POSTGRES_USER: postgres
      POSTGRES_HOST: /var/run/postgresql
      JWT_EXP: "{{ data_platform_jwt_expiry | string }}"
    volumes:
      - {{ data_platform_data_dir }}/postgres:/var/lib/postgresql/data
      - {{ data_platform_migrations_dir }}:/migrations:ro
    ports:
      - "127.0.0.1:{{ data_platform_postgres_host_port | int }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -h 127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: db

  rest:
    image: "{{ data_platform_postgrest_image_repository }}@{{ data_platform_postgrest_image_digest }}"
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - "{{ data_platform_config_dir }}/stack.env"
    environment:
      PGRST_DB_SCHEMAS: ops_ledger
      PGRST_DB_ANON_ROLE: anon
      PGRST_DB_USE_LEGACY_GUCS: "false"
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: rest

  auth:
    image: "{{ data_platform_gotrue_image_repository }}@{{ data_platform_gotrue_image_digest }}"
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - "{{ data_platform_config_dir }}/stack.env"
    environment:
      GOTRUE_API_HOST: 0.0.0.0
      GOTRUE_API_PORT: "9999"
      API_EXTERNAL_URL: "{{ data_platform_public_url }}"
      GOTRUE_DB_DRIVER: postgres
      GOTRUE_DB_NAMESPACE: auth
      GOTRUE_SITE_URL: "{{ data_platform_site_url }}"
      GOTRUE_DISABLE_SIGNUP: "true"
      GOTRUE_JWT_ADMIN_ROLES: service_role
      GOTRUE_JWT_AUD: authenticated
      GOTRUE_JWT_DEFAULT_GROUP_NAME: authenticated
      GOTRUE_JWT_EXP: "{{ data_platform_jwt_expiry | string }}"
      GOTRUE_EXTERNAL_EMAIL_ENABLED: "false"
      GOTRUE_MAILER_AUTOCONFIRM: "true"
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: auth

  meta:
    image: "{{ data_platform_meta_image_repository }}@{{ data_platform_meta_image_digest }}"
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - "{{ data_platform_config_dir }}/stack.env"
    environment:
      PG_META_PORT: "8080"
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: meta

  studio:
    image: "{{ data_platform_studio_image_repository }}@{{ data_platform_studio_image_digest }}"
    restart: unless-stopped
    depends_on:
      - meta
      - rest
    env_file:
      - "{{ data_platform_config_dir }}/stack.env"
    environment:
      HOSTNAME: "0.0.0.0"
      STUDIO_PG_META_URL: http://meta:8080
      SUPABASE_URL: http://kong:8000
      SUPABASE_PUBLIC_URL: "{{ data_platform_public_url }}"
    ports:
      - "127.0.0.1:{{ data_platform_studio_host_port | int }}:3000"
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: studio

  kong:
    image: "{{ data_platform_kong_image_repository }}@{{ data_platform_kong_image_digest }}"
    restart: unless-stopped
    depends_on:
      - rest
      - auth
    environment:
      KONG_DATABASE: "off"
      KONG_DECLARATIVE_CONFIG: /kong.yml
      KONG_DNS_ORDER: LAST,A,CNAME
      KONG_PLUGINS: request-transformer,cors,key-auth,acl
      KONG_NGINX_PROXY_PROXY_BUFFER_SIZE: 160k
      KONG_NGINX_PROXY_PROXY_BUFFERS: 64 160k
    volumes:
      - {{ data_platform_config_dir }}/kong.yml:/kong.yml:ro
    ports:
      - "{{ data_platform_kong_port | int }}:8000"
    networks:
      - data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "{{ data_platform_log_max_size }}"
        max-file: "{{ data_platform_log_max_file }}"
    labels:
      homelab.role: data_platform
      homelab.component: kong

networks:
  data:
    name: "{{ data_platform_network_name }}"
    enable_ipv6: false
    ipam:
      config:
        - subnet: {{ data_platform_network_subnet }}
