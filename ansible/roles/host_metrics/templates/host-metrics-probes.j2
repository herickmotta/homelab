#!/usr/bin/env bash
# Managed by herickmotta.homelab.host_metrics.
set -euo pipefail

textfile_dir={{ host_metrics_textfile_dir | quote }}
tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT

{
{% if host_metrics_local_tcp_probes | length > 0 %}
  echo '# HELP homelab_local_tcp_up Whether a host TCP connect probe succeeded (1) or failed (0). Connect only; no payload. Published-port peers appear as the Docker bridge gateway inside the container.'
  echo '# TYPE homelab_local_tcp_up gauge'
{% for probe in host_metrics_local_tcp_probes %}
  if timeout 2 bash -c 'exec 3<>/dev/tcp/{{ probe.address.split(":")[0] }}/{{ probe.address.split(":")[1] }}' 2>/dev/null; then
    echo 'homelab_local_tcp_up{name="{{ probe.name }}",address="{{ probe.address }}"} 1'
  else
    echo 'homelab_local_tcp_up{name="{{ probe.name }}",address="{{ probe.address }}"} 0'
  fi
{% endfor %}
{% endif %}
{% if host_metrics_container_probes | length > 0 %}
  echo '# HELP homelab_container_up Whether an allowlisted Compose container is running (1) or absent (0).'
  echo '# TYPE homelab_container_up gauge'
{% for probe in host_metrics_container_probes %}
  if [ "$(docker ps -q --filter 'label={{ probe.label }}' --filter status=running | wc -l | tr -d ' ')" -ge 1 ]; then
    echo 'homelab_container_up{name="{{ probe.name }}"} 1'
  else
    echo 'homelab_container_up{name="{{ probe.name }}"} 0'
  fi
{% endfor %}
{% endif %}
{% if host_metrics_docker_inventory_active | default(false) | bool %}
  python3 {{ host_metrics_lib_dir }}/docker_inventory.py
{% endif %}
} >"${tmp}"

install -m 0644 "${tmp}" "${textfile_dir}/homelab-probes.prom"
