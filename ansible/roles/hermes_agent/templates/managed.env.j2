# Managed by herickmotta.homelab.hermes_agent. Mode 0640; not world-readable.
TELEGRAM_BOT_TOKEN={{ hermes_agent_telegram_bot_token }}
TELEGRAM_ALLOWED_USERS={{ hermes_agent_telegram_user_id | string }}
GATEWAY_ALLOW_ALL_USERS=false
API_SERVER_ENABLED=false
HERMES_DASHBOARD=0
{% if hermes_agent_provider_env_name | length > 0 %}
{{ hermes_agent_provider_env_name }}={{ hermes_agent_provider_api_key }}
{% endif %}
{% if hermes_agent_github_enabled | bool or hermes_agent_pve_enabled | bool %}
PATH={{ hermes_agent_container_managed_dir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
{% endif %}
{% if hermes_agent_github_enabled | bool %}
HERMES_GITHUB_APP_ID={{ hermes_agent_github_app_id | string }}
HERMES_GITHUB_INSTALLATION_ID={{ hermes_agent_github_installation_id | string }}
HERMES_GITHUB_APP_KEY_FILE={{ hermes_agent_container_managed_dir }}/github-app.pem
GIT_CONFIG_GLOBAL={{ hermes_agent_container_data_dir }}/home/.gitconfig
{% endif %}
{% if hermes_agent_webhook_enabled | bool %}
WEBHOOK_ENABLED=true
WEBHOOK_PORT={{ hermes_agent_webhook_port | string }}
WEBHOOK_SECRET={{ hermes_agent_webhook_secret }}
{% endif %}
{% if hermes_agent_pve_enabled | bool %}
PVE_API_ENDPOINT=https://{{ hermes_agent_pve_ipv4 }}:{{ hermes_agent_pve_port | int }}
PVE_API_TOKEN_ID={{ hermes_agent_pve_user }}!{{ hermes_agent_pve_token_name }}
PVE_API_TOKEN_SECRET={{ hermes_agent_pve_token_value }}
PVE_API_VERIFY_SSL={{ '1' if (hermes_agent_pve_verify_ssl | bool) else '0' }}
{% endif %}
