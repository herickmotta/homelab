#!/bin/sh
# GET-only Proxmox API helper. Path is relative to /api2/json/.
# Credentials live in sibling files, not TOKEN/SECRET env vars: Hermes
# execute_code/terminal sandboxes strip those names.
set -eu

usage() {
  printf '%s\n' "usage: pve-get <api-path>" >&2
  printf '%s\n' "example: pve-get version" >&2
  printf '%s\n' "example: pve-get nodes/pve/qemu" >&2
  exit 1
}

[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && usage
[ "$#" -eq 1 ] || usage

path=$1
path=${path#/}
path=${path#api2/json/}
path=${path#/}

case "$path" in
  "" | *..* | *[[:space:]]* | *'*'* | *'?'*)
    printf '%s\n' "refused: invalid API path" >&2
    exit 1
    ;;
  *status/start | *status/stop | *status/shutdown | *status/reboot | *status/reset)
    printf '%s\n' "refused: this helper is GET-only" >&2
    exit 1
    ;;
esac

bindir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
pvedir=$(CDPATH= cd -- "${bindir}/../pve" && pwd)

read_file() {
  file=$1
  label=$2
  if [ ! -f "$file" ]; then
    printf '%s\n' "refused: missing ${label} (${file})" >&2
    exit 1
  fi
  tr -d '\n' <"$file"
}

endpoint=$(read_file "${pvedir}/endpoint" "PVE endpoint")
token_id=$(read_file "${pvedir}/token-id" "PVE token id")
token_secret=$(read_file "${pvedir}/token-secret" "PVE token secret")
verify=$(read_file "${pvedir}/verify-ssl" "PVE TLS verify")

verify_args="-k"
if [ "$verify" = "1" ]; then
  verify_args=""
fi

# shellcheck disable=SC2086
curl -sS ${verify_args} -X GET \
  -H "Authorization: PVEAPIToken=${token_id}=${token_secret}" \
  "${endpoint%/}/api2/json/${path}"
printf '\n'
